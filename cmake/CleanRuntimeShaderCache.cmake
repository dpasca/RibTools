if (NOT DEFINED RIBTOOLS_RUNTIME_DIRECTORY OR RIBTOOLS_RUNTIME_DIRECTORY STREQUAL "")
    message(FATAL_ERROR "RIBTOOLS_RUNTIME_DIRECTORY must name the runtime directory")
endif()

get_filename_component(
    RIBTOOLS_RUNTIME_DIRECTORY
    "${RIBTOOLS_RUNTIME_DIRECTORY}"
    ABSOLUTE)

if (NOT IS_DIRECTORY "${RIBTOOLS_RUNTIME_DIRECTORY}")
    message(STATUS "Runtime directory does not exist; no shader caches to remove")
    return()
endif()

file(
    GLOB_RECURSE RIBTOOLS_GENERATED_SHADER_FILES
    LIST_DIRECTORIES FALSE
    "${RIBTOOLS_RUNTIME_DIRECTORY}/*.autogen.rrasm")
list(LENGTH RIBTOOLS_GENERATED_SHADER_FILES RIBTOOLS_GENERATED_SHADER_COUNT)

if (RIBTOOLS_GENERATED_SHADER_FILES)
    file(REMOVE ${RIBTOOLS_GENERATED_SHADER_FILES})
endif()

message(STATUS "Removed ${RIBTOOLS_GENERATED_SHADER_COUNT} generated shader cache file(s)")
