foreach(REQUIRED_VARIABLE RENDERER SCENE OUTPUT_FILE RIBTOOLS_DIR TEST_NAME)
    if (NOT DEFINED ${REQUIRED_VARIABLE})
        message(FATAL_ERROR "Missing required variable: ${REQUIRED_VARIABLE}")
    endif()
endforeach()

get_filename_component(OUTPUT_DIRECTORY "${OUTPUT_FILE}" DIRECTORY)
get_filename_component(SCENE_NAME "${SCENE}" NAME)
get_filename_component(SCENE_DIRECTORY "${SCENE}" DIRECTORY)
file(
    RELATIVE_PATH SCENE_RELATIVE_DIRECTORY
    "${RIBTOOLS_DIR}/TestScenes"
    "${SCENE_DIRECTORY}")
if (SCENE_RELATIVE_DIRECTORY MATCHES "^\\.\\.")
    message(FATAL_ERROR "Scene must be inside ${RIBTOOLS_DIR}/TestScenes: ${SCENE}")
endif()

get_filename_component(
    SCENE_RELATIVE_PARENT_DIRECTORY
    "${SCENE_RELATIVE_DIRECTORY}"
    DIRECTORY)
set(STAGING_ROOT "${OUTPUT_DIRECTORY}/${TEST_NAME}-runtime")
set(
    STAGED_SCENE_PARENT_DIRECTORY
    "${STAGING_ROOT}/TestScenes/${SCENE_RELATIVE_PARENT_DIRECTORY}")
set(STAGED_SCENE_DIRECTORY "${STAGING_ROOT}/TestScenes/${SCENE_RELATIVE_DIRECTORY}")
set(STAGED_SCENE "${STAGED_SCENE_DIRECTORY}/${SCENE_NAME}")

file(REMOVE "${OUTPUT_FILE}")
file(REMOVE_RECURSE "${STAGING_ROOT}")
file(MAKE_DIRECTORY "${STAGED_SCENE_PARENT_DIRECTORY}")
file(COPY "${RIBTOOLS_DIR}/ribtools.ini" DESTINATION "${STAGING_ROOT}")
file(COPY "${RIBTOOLS_DIR}/Resources" DESTINATION "${STAGING_ROOT}")
file(COPY "${SCENE_DIRECTORY}" DESTINATION "${STAGED_SCENE_PARENT_DIRECTORY}")

set(RENDER_COMMAND "${RENDERER}" "${STAGED_SCENE}")
if (DEFINED FORCED_LONG_DIM)
    if (NOT FORCED_LONG_DIM MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "FORCED_LONG_DIM must be a positive integer")
    endif()
    list(APPEND RENDER_COMMAND -forcedlongdim "${FORCED_LONG_DIM}")
endif()

execute_process(
    COMMAND
        "${CMAKE_COMMAND}" -E env
        "RIBTOOLS_DIR=${STAGING_ROOT}"
        ${RENDER_COMMAND}
    WORKING_DIRECTORY "${OUTPUT_DIRECTORY}"
    RESULT_VARIABLE RENDER_RESULT
    OUTPUT_VARIABLE RENDER_STDOUT
    ERROR_VARIABLE RENDER_STDERR)

string(CONCAT RENDER_LOG "${RENDER_STDOUT}" "${RENDER_STDERR}")

if (NOT RENDER_RESULT EQUAL 0)
    message(FATAL_ERROR "Renderer exited with ${RENDER_RESULT}:\n${RENDER_LOG}")
endif()

if (RENDER_LOG MATCHES "SCENE ERR>|SHADER ERROR:")
    message(FATAL_ERROR "Renderer reported an error:\n${RENDER_LOG}")
endif()

if (NOT EXISTS "${OUTPUT_FILE}")
    message(FATAL_ERROR "Renderer did not create ${OUTPUT_FILE}:\n${RENDER_LOG}")
endif()

message(STATUS "Visual regression render completed:\n${RENDER_LOG}")
